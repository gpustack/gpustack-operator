        "modeldeployment.gpustack.ai/member-index": "0",
        "modeldeployment.gpustack.ai/pod-ordinal": "0",
        "modeldeployment.gpustack.ai/role-kind": "prefill",
        "resource.gpustack.ai/type": "modeldeployments"
      },
      "annotations": {
        "kueue.x-k8s.io/pod-group-serving": "true",
        "kueue.x-k8s.io/pod-group-total-count": "1",
        "kueue.x-k8s.io/role-hash": "prefill",
        "modeldeployment.gpustack.ai/pod-spec-hash": "bca533c3c2ce4c9d37e25f196c73e67292a334af126c64890465a831ffb4217f",
        "note.gpustack.ai/role": "prefill",
        "prometheus.io/path": "/metrics",
        "prometheus.io/port": "8000",
        "prometheus.io/scheme": "http",
        "prometheus.io/scrape": "true"
      },
      "ownerReferences": [
        {
          "apiVersion": "worker.gpustack.ai/v1alpha1",
          "kind": "ModelDeployment",
          "name": "qwen",
          "uid": "md-uid",
          "controller": true,
          "blockOwnerDeletion": false
        }
      ]
    },
    "spec": {
      "volumes": [
        {
          "name": "model-shm",
          "emptyDir": {
            "medium": "Memory",
            "sizeLimit": "16Gi"
          }
        }
      ],
      "containers": [
        {
          "name": "main",
          "image": "vllm/vllm-openai:v0.25.1",
          "command": [
            "vllm",
            "serve",
            "Qwen/Qwen2.5-72B-Instruct",
            "--host",
            "0.0.0.0",
            "--port",
            "8000"
          ],
          "ports": [
            {
              "name": "http",
              "containerPort": 8000,
              "protocol": "TCP"
            }
          ],
          "resources": {
            "limits": {
              "cpu": "16",
              "ephemeral-storage": "15Gi",
              "memory": "64Gi",
              "nvidia.com/gpu": "1"
            },
            "requests": {
              "cpu": "1600m",
              "ephemeral-storage": "1920Mi",
              "memory": "8Gi",
              "nvidia.com/gpu": "1"
            }
          },
          "volumeMounts": [
            {
              "name": "model-shm",
              "mountPath": "/dev/shm"
            }
          ],
          "livenessProbe": {
            "httpGet": {
              "path": "/health",
              "port": 8000,
              "scheme": "HTTP"
            },
            "timeoutSeconds": 3,
            "periodSeconds": 10,
            "failureThreshold": 6
          },
          "readinessProbe": {
            "httpGet": {
              "path": "/health",
              "port": 8000,
              "scheme": "HTTP"
            },
            "timeoutSeconds": 3,
            "periodSeconds": 10,
            "failureThreshold": 3
          },
          "startupProbe": {
            "httpGet": {
              "path": "/health",
              "port": 8000,
              "scheme": "HTTP"
            },
            "timeoutSeconds": 3,
            "periodSeconds": 10,
            "failureThreshold": 180
          },
          "lifecycle": {
            "preStop": {
              "exec": {
                "command": [
                  "python3",
                  "-c",
                  "import socket, ssl, sys, time, urllib.request\nstart = time.monotonic()\ntime.sleep(5)\nnames = [\"vllm:num_requests_running\", \"vllm:num_requests_waiting\"]\ncontext = ssl.create_default_context()\ncontext.check_hostname = False\ncontext.verify_mode = ssl.CERT_NONE\nidle = 0\nwhile time.monotonic() - start \u003c 25:\n    try:\n        body = urllib.request.urlopen(\"http://127.0.0.1:8000/metrics\", timeout=1, context=context).read().decode()\n    except Exception as err:\n        if not isinstance(getattr(err, \"reason\", err), (TimeoutError, socket.timeout)):\n            sys.exit(0)\n        body = None\n    busy = 1.0 if body is None else 0.0\n    for line in (body or \"\").splitlines():\n        name = line.split(\"{\", 1)[0].split(\" \", 1)[0]\n        if name not in names:\n            continue\n        sample = line.rsplit(\"}\", 1)[1] if \"{\" in line else line[len(name):]\n        try:\n            busy += float(sample.split()[0])\n        except (IndexError, ValueError):\n            busy += 1.0\n    idle = idle + 1 if busy == 0 else 0\n    if idle == 2:\n        sys.exit(0)\n    time.sleep(1)\nsys.exit(0)\n"
                ]
              }
            }
          }
        }
      ],
      "restartPolicy": "Always",
      "terminationGracePeriodSeconds": 30,
      "automountServiceAccountToken": false,
      "runtimeClassName": "nvidia",
      "enableServiceLinks": false
    },
    "status": {}
  },
