[
  {
    "metadata": {
      "generateName": "qwen-prefill-",
      "namespace": "team-a",
      "labels": {
        "app.kubernetes.io/component": "prefill",
        "app.kubernetes.io/instance": "qwen",
        "app.kubernetes.io/name": "model-deployment",
        "app.kubernetes.io/part-of": "gpustack-operator-worker",
        "kueue.x-k8s.io/pod-group-name": "gpustack-fnv64-d8143bebd0d350d8",
        "kueue.x-k8s.io/queue-name": "queue-for-h20-8x",
        "modeldeployment.gpustack.ai/member-index": "0",
        "modeldeployment.gpustack.ai/pod-ordinal": "0",
        "modeldeployment.gpustack.ai/role-kind": "prefill",
        "resource.gpustack.ai/type": "modeldeployments"
      },
      "annotations": {
        "kueue.x-k8s.io/pod-group-serving": "true",
        "kueue.x-k8s.io/pod-group-total-count": "1",
        "kueue.x-k8s.io/role-hash": "prefill",
        "modeldeployment.gpustack.ai/pod-spec-hash": "480af388f75dc696847e7c615eb5d2dd7e9442c5e6f4dba0d0677dbcce8bf50c",
        "modeldeployment.gpustack.ai/render-version": "6",
        "note.gpustack.ai/role": "prefill",
        "prometheus.io/path": "/metrics",
        "prometheus.io/port": "8000",
        "prometheus.io/scheme": "http",
        "prometheus.io/scrape": "true"
      },
      "ownerReferences": [
        {
          "apiVersion": "worker.gpustack.ai/v1alpha1",
          "kind": "ModelDeployment",
          "name": "qwen",
          "uid": "md-uid",
          "controller": true,
          "blockOwnerDeletion": false
        }
      ]
    },
    "spec": {
      "volumes": [
        {
          "name": "gpustack-compile-cache",
          "hostPath": {
            "path": "/var/lib/gpustack/cache/nvidia-vllm/m-1a67e1afa7075ef35646bfd3ee97d8de/tp1-pp1-dp1-ep1-cp1_1-361d188c",
            "type": "DirectoryOrCreate"
          }
        },
        {
          "name": "model-shm",
          "emptyDir": {
            "medium": "Memory",
            "sizeLimit": "16Gi"
          }
        },
        {
          "name": "gpustack-engine-sentinel",
          "hostPath": {
            "path": "/var/lib/gpustack/operator/lib/engine-sentinel",
            "type": "DirectoryOrCreate"
          }
        }
      ],
      "containers": [
        {
          "name": "main",
          "image": "vllm/vllm-openai:v0.25.1",
          "command": [
            "vllm",
            "serve",
            "Qwen/Qwen2.5-72B-Instruct",
            "--host",
            "0.0.0.0",
            "--port",
            "8000"
          ],
          "ports": [
            {
              "name": "http",
              "containerPort": 8000,
              "protocol": "TCP"
            }
          ],
          "env": [
            {
              "name": "VLLM_CACHE_ROOT",
              "value": "/var/lib/gpustack/cache"
            },
            {
              "name": "HF_HUB_CACHE",
              "value": "/var/lib/gpustack/cache/hf-hub"
            },
            {
              "name": "HF_XET_CACHE",
              "value": "/var/lib/gpustack/cache/xet"
            },
            {
              "name": "PIP_CACHE_DIR",
              "value": "/var/lib/gpustack/cache/pip"
            },
            {
              "name": "TORCH_HOME",
              "value": "/var/lib/gpustack/cache/torch"
            },
            {
              "name": "FLASHINFER_WORKSPACE_BASE",
              "value": "/var/lib/gpustack/cache/flashinfer"
            },
            {
              "name": "TORCHINDUCTOR_CACHE_DIR",
              "value": "/var/lib/gpustack/cache/inductor"
            },
            {
              "name": "TRITON_CACHE_DIR",
              "value": "/var/lib/gpustack/cache/triton"
            },
            {
              "name": "PYTHONPATH",
              "value": "/var/lib/gpustack/operator/lib/engine-sentinel"
            },
            {
              "name": "GPUSTACK_ENGINE_SENTINEL_ENABLE",
              "value": "1"
            },
            {
              "name": "GPUSTACK_ENGINE_SENTINEL_ENGINE",
              "value": "vllm"
            }
          ],
          "resources": {
            "limits": {
              "nvidia.com/gpu": "1"
            },
            "requests": {
              "nvidia.com/gpu": "1"
            }
          },
          "volumeMounts": [
            {
              "name": "gpustack-compile-cache",
              "mountPath": "/var/lib/gpustack/cache"
            },
            {
              "name": "model-shm",
              "mountPath": "/dev/shm"
            },
            {
              "name": "gpustack-engine-sentinel",
              "readOnly": true,
              "mountPath": "/var/lib/gpustack/operator/lib/engine-sentinel"
            }
          ],
          "livenessProbe": {
            "httpGet": {
              "path": "/gpustack/v1/live",
              "port": 8000,
              "scheme": "HTTP"
            },
            "timeoutSeconds": 5,
            "periodSeconds": 10,
            "failureThreshold": 6
          },
          "readinessProbe": {
            "httpGet": {
              "path": "/gpustack/v1/ready",
              "port": 8000,
              "scheme": "HTTP"
            },
            "timeoutSeconds": 5,
            "periodSeconds": 10,
            "failureThreshold": 3
          },
          "startupProbe": {
            "httpGet": {
              "path": "/gpustack/v1/live",
              "port": 8000,
              "scheme": "HTTP"
            },
            "timeoutSeconds": 5,
            "periodSeconds": 10,
            "failureThreshold": 180
          },
          "lifecycle": {
            "preStop": {
              "exec": {
                "command": [
                  "python3",
                  "-m",
                  "gpustack_engine_sentinel.drain",
                  "--engine",
                  "vLLM",
                  "--port",
                  "8000",
                  "--scheme",
                  "http",
                  "--settle",
                  "5",
                  "--deadline",
                  "25"
                ]
              }
            }
          }
        }
      ],
      "restartPolicy": "Always",
      "terminationGracePeriodSeconds": 30,
      "automountServiceAccountToken": false,
      "runtimeClassName": "nvidia",
      "enableServiceLinks": false
    },
    "status": {}
  },
