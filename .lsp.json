{
  "c": {
    "command": "clangd",
    "args": [
      "--background-index"
    ]
  },
  "cpp": {
    "command": "clangd",
    "args": [
      "--background-index",
      "--clang-tidy",
      "--header-insertion=iwyu",
      "--completion-style=detailed"
    ]
  },
  "go": {
    "command": "gopls"
  }
}
