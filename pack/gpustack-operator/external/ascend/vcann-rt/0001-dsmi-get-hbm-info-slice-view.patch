index 0000000..7521bd4
--- /dev/null
+++ b/src/dsmi/dsmi_hook.c
@@ -0,0 +1,213 @@
+/*
+ * Copyright (c) GPUStack contributors. 2026.
+ * A vendored addition to ubs-virt-enpu/vcann-rt, licensed under Mulan PSL v2 like the
+ * tree it extends. You may obtain a copy of Mulan PSL v2 at:
+ *          http://license.coscl.org.cn/MulanPSL2
+ * THIS SOFTWARE IS PROVIDED ON AN "AS IS" BASIS, WITHOUT WARRANTIES OF ANY KIND,
+ * EITHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT,
+ * MERCHANTABILITY OR FIT FOR A PARTICULAR PURPOSE.
+ * See the Mulan PSL v2 for more details.
+ */
+
+/*
+ * dsmi_get_hbm_info — make the logical slice visible in `npu-smi info`.
+ *
+ * vcann-rt interposes the CANN runtime (rt*) layer, which npu-smi never enters: it
+ * links libdrvdsmi_host.so + libascend_hal.so, imports zero rt symbols, and therefore
+ * keeps reporting the whole physical card inside a sliced container. It does import
+ * the dsmi getters through its PLT, and libvruntime.so is already an entry of the
+ * sliced container's /etc/ld.so.preload — so defining the one getter npu-smi reads the
+ * HBM numbers from is enough, with no extra library, mount or preload entry.
+ *
+ * Two fields of one struct are rewritten:
+ *   memory_size  := the container's memory-quota, clamped to the card's real total
+ *   memory_usage := the slice's own usage, the same number enpu-monitor prints
+ * Every other field, getter and device is passed through, so power, temperature and
+ * Bus-Id stay card-wide by construction.
+ *
+ * Off unless ENPU_DSMI_HOOK enables it, and a pure passthrough whenever the process
+ * has no vcann-rt config or the queried device is not the sliced one — dsmi names
+ * devices by container-local logic id, so that last check has to translate.
+ */
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include "common.h"
+#include "config.h"
+#include "dcmi_wrapper.h"
+#include "npu_manager.h"
+
+/*
+ * From driver/include/dsmi_common_interface.h, declared here rather than included:
+ * the build image carries no host HDK (build-libvnpu.sh stubs libdcmi from
+ * test/stub), so no dsmi header exists at compile time. Sizes are in KB.
+ */
+struct dsmi_hbm_info_stru {
+    unsigned long long memory_size;
+    unsigned int freq;
+    unsigned long long memory_usage;
+    int temp;
+    unsigned int bandwith_util_rate;
+};
+
+#define DSMI_HOOK_ENV "ENPU_DSMI_HOOK"
+#define B_TO_KB (1024ULL)
+
+typedef int (*dsmi_get_hbm_info_fn)(int device_id, struct dsmi_hbm_info_stru *info);
+/* dsmi_common_interface.h:2268 — the logic id is what the caller passes to every dsmi
+ * getter, and inside a container it is renumbered: a container scoped to physical NPU 1
+ * queries logic id 0. dcmi, and therefore npu_info.config's physical-npu-id, stays
+ * physical, so the two only line up on card 0 — hence this mapping (measured). */
+typedef int (*dsmi_get_phyid_from_logicid_fn)(unsigned int logicid, unsigned int *phyid);
+
+/*
+ * Which dcmi family the driver ships. enpu_soc_init() answers that with
+ * rtGetSocVersion, but npu-smi has no libruntime.so to ask, so probe the weak symbol
+ * instead: an Ascend950 driver ships the dcmiv2_* entry points, the others dcmi_*.
+ */
+extern int dcmi_get_card_id_device_id_from_phyid(int *card_id, int *device_id, unsigned int device_phy_id)
+    __attribute__((weak));
+
+static pthread_once_t g_hook_once = PTHREAD_ONCE_INIT;
+static dsmi_get_hbm_info_fn g_real_hbm_info = NULL;
+static dsmi_get_phyid_from_logicid_fn g_real_phyid_of = NULL;
+static bool g_hook_enabled = false; /* ENPU_DSMI_HOOK opted in */
+static bool g_quota_known = false;  /* config parsed, so memory_size can be rewritten */
+static bool g_usage_known = false;  /* dcmi ids resolved, so memory_usage can be too */
+static int g_card_id = -1;
+static int g_device_id = -1;
+static int g_logic_id = -1;
+
+static bool hook_enabled_by_env(void)
+{
+    const char *val = getenv(DSMI_HOOK_ENV);
+    if (val == NULL) {
+        return false;
+    }
+    if (strcmp(val, "1") == 0 || strcasecmp(val, "true") == 0 || strcasecmp(val, "on") == 0) {
+        return true;
+    }
+    if (strcmp(val, "0") == 0 || strcasecmp(val, "false") == 0 || strcasecmp(val, "off") == 0) {
+        return false;
+    }
+    /* The channel parse_level_env() uses for a bad ENPU_LOG_LEVEL: a plain tool process
+     * never initializes the log module, so stderr is the only one that reaches anyone. */
+    fprintf(stderr, "[eNPU] Invalid %s='%s', the dsmi hook stays off.\n", DSMI_HOOK_ENV, val);
+    return false;
+}
+
+static void dsmi_hook_init(void)
+{
+    g_real_hbm_info = (dsmi_get_hbm_info_fn)dlsym(RTLD_NEXT, "dsmi_get_hbm_info");
+    g_real_phyid_of = (dsmi_get_phyid_from_logicid_fn)dlsym(RTLD_NEXT, "dsmi_get_phyid_from_logicid");
+    g_hook_enabled = hook_enabled_by_env();
+    if (!g_hook_enabled || g_real_hbm_info == NULL) {
+        return;
+    }
+
+    if (check_init_success()) {
+        /* A CANN process: the rt hooks already ran the full init, so reuse the ids it
+         * resolved instead of re-deciding the dcmi family behind its back. */
+        g_card_id = get_card_id();
+        g_device_id = get_device_id();
+        g_logic_id = get_logic_id();
+        g_quota_known = true;
+        g_usage_known = true;
+        return;
+    }
+
+    /* npu-smi and every other non-CANN process: enpu_global_init() cannot get past
+     * enpu_soc_init() without libruntime.so, so do its rt-free half here.
+     *
+     * Nothing on this path initializes the log module, so any log_print() a vcann-rt helper
+     * below reaches prints "[eNPU] Log module not initialized" to stderr in place of its
+     * message -- one line per call, straight into the output of a tool like npu-smi. A
+     * threshold of FATAL has each LOG_ macro fail its own gate, so log_print() is never even
+     * reached; FATAL itself has no call site upstream. The value is FATAL rather than one
+     * below it because EnpuLogLevel has no negative enumerator and so is unsigned: FATAL - 1
+     * converts to UINT_MAX, which passes every gate and prints MORE than leaving it alone.
+     * It is put back rather than left lowered because log_init() early-returns once the
+     * module is up and would never restore it, and check_init_success() above reports
+     * npu-manager rather than the log module: a process whose log module IS running while
+     * npu-manager init merely failed must keep its configured level, being the one that most
+     * needs it. */
+    EnpuLogLevel level = g_log_config.min_log_level;
+    uint8_t soc;
+
+    g_log_config.min_log_level = ENPU_LOG_FATAL;
+
+    if (enpu_load_config() != ENPU_SUCCESS) {
+        fprintf(stderr, "[eNPU] %s is on but %s is unusable, so the physical card is reported.\n", DSMI_HOOK_ENV,
+                NPU_CONFIG_PATH);
+        goto restore;
+    }
+    g_quota_known = true;
+
+    /* Only the 950 branch matters here: register_callback() routes 910 and 310 to one
+     * get_device_resource_info_callback, and that is the sole callback this hook uses. */
+    soc = (dcmi_get_card_id_device_id_from_phyid != NULL) ? SOC_VERSION_ASCEND_910 : SOC_VERSION_ASCEND_950;
+    if (register_callback(soc) != ENPU_SUCCESS) {
+        goto restore;
+    }
+    /* Out-params only: this leaves the npu manager's own state alone. */
+    if (enpu_dcmi_get_card_info((uint32_t)config.phy_npu_id, &g_card_id, &g_device_id, &g_logic_id, soc) !=
+        ENPU_SUCCESS) {
+        goto restore; /* the quota is still reported; only the slice's own usage is lost */
+    }
+    g_usage_known = true;
+
+restore:
+    g_log_config.min_log_level = level;
+}
+
+__attribute__((visibility("default"))) int dsmi_get_hbm_info(int device_id, struct dsmi_hbm_info_stru *info)
+{
+    (void)pthread_once(&g_hook_once, dsmi_hook_init);
+
+    if (g_real_hbm_info == NULL) {
+        /* libdrvdsmi_host.so is not in this process, so there is nothing to report. */
+        return ENPU_FAIL;
+    }
+
+    int rc = g_real_hbm_info(device_id, info);
+    if (rc != 0 || info == NULL || !g_hook_enabled || !g_quota_known) {
+        return rc;
+    }
+    /* libvruntime.so is preloaded container-wide and this is a strong definition, so
+     * every process here lands in it: only the sliced device gets rewritten. The caller
+     * names the device by logic id, which the config does not carry, so translate — and
+     * report the card untouched when that mapping is unavailable rather than guess. */
+    unsigned int phy_id = 0;
+    if (g_real_phyid_of == NULL || g_real_phyid_of((unsigned int)device_id, &phy_id) != 0 ||
+        (int32_t)phy_id != config.phy_npu_id) {
+        return rc;
+    }
+
+    unsigned long long total_kb = info->memory_size;
+    unsigned long long quota_kb = (unsigned long long)get_mem_limit_quota() / B_TO_KB;
+    if (quota_kb > total_kb) {
+        /* What __enpu_global_init_post() spends rtMemGetInfoEx on: a quota larger than
+         * the card is not a slice. The passthrough already carries the card's total. */
+        quota_kb = total_kb;
+    }
+
+    unsigned long long usage_kb = info->memory_usage;
+    size_t used = 0;
+    if (g_usage_known &&
+        enpu_dcmi_get_device_resource_info(g_logic_id, g_card_id, g_device_id, &used) == ENPU_SUCCESS) {
+        usage_kb = (unsigned long long)used / B_TO_KB;
+    }
+    if (usage_kb > quota_kb) {
+        usage_kb = quota_kb;
+    }
+
+    LOG_DEBUG("Dsmi hook rewrote device %d: total %lluKB -> %lluKB, usage %lluKB -> %lluKB.", device_id, total_kb,
+              quota_kb, info->memory_usage, usage_kb);
+    info->memory_size = quota_kb;
+    info->memory_usage = usage_kb;
+    return rc;
+}
