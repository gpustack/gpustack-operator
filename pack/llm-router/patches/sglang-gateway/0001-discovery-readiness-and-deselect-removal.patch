+
+/// Withdraw the registration held for a Pod UID, if there is one.
+///
+/// Returns whether the withdrawal was delivered. A Pod that was never registered is a
+/// delivered no-op: there was nothing in the registry to remove.
+async fn withdraw_worker(
+    uid: &str,
+    tracked_pods: &Arc<Mutex<HashMap<String, PodInfo>>>,
+    app_context: &Arc<AppContext>,
+    port: u16,
+) -> bool {
+    let registered = {
+        let tracker = match tracked_pods.lock() {
+            Ok(tracker) => tracker,
+            Err(e) => {
+                error!("Failed to acquire tracked_pods lock: {}", e);
+                return false;
+            }
+        };
+        tracker.get(uid).cloned()
+    };
+
+    match registered {
+        Some(registered) => {
+            withdraw_registration(&registered, tracked_pods, app_context, port).await
+        }
+        None => {
+            // Nothing was registered for this identity, so there is nothing to
+            // withdraw. This is the normal outcome for a duplicate event, for a Pod
+            // that was never healthy, and for a deletion arriving after the worker was
+            // already withdrawn.
+            debug!("No worker registration held for pod uid: {}", uid);
+            true
+        }
+    }
+}
+
+/// Hand one registered worker's removal to the worker service and, only on success,
+/// drop the registration that described it.
+///
+/// The registration is keyed by UID and holds the details the worker was ADDED with,
+/// so a withdrawal issued for an identity that has since been replaced at the same
+/// address removes that old address rather than the new occupant's. That guarantee
+/// rests on the address having a single owner, which register_worker enforces before
+/// admitting a new UID.
+///
+/// Returns whether the removal job COMPLETED. That is stronger than acceptance and
+/// stronger than upstream's behaviour, but still weaker than the worker having stopped
+/// serving: the job reports the outcome of its own workflow against the registry, and
+/// nothing here observes a request afterwards. Upstream dropped the tracking entry before submitting, so a rejected
+/// submission left the registration forgotten while the worker stayed in the pool;
+/// keeping it here is what lets the relist-driven retry deliver it instead.
+async fn withdraw_registration(
+    registered: &PodInfo,
+    tracked_pods: &Arc<Mutex<HashMap<String, PodInfo>>>,
+    app_context: &Arc<AppContext>,
+    port: u16,
+) -> bool {
+    let worker_url = registered.worker_url(port);
+
+    info!(
+        "Removing pod: {} | uid: {} | type: {:?} | url: {}",
+        registered.name, registered.uid, registered.pod_type, worker_url
+    );
+
+    let job = Job::RemoveWorker {
+        url: worker_url.clone(),
+    };
+
+    let Some(job_queue) = app_context.worker_job_queue.get() else {
+        error!(
+            "JobQueue not initialized, retaining registration for {} because the removal was not queued",
+            worker_url
+        );
+        return false;
+    };
+
+    // Wait for the removal to actually finish rather than for the queue to accept it.
+    // The queue gives each job its own task, so acceptance says nothing about completion,
+    // and the worker registry is keyed by URL, so an addition that was accepted earlier
+    // but is still running can land after this removal and put the worker back. The
+    // outer bound is wider than the removal workflow's own timeout so the workflow's own
+    // error is what normally surfaces.
+    let completion_budget = Duration::from_secs(60);
+    if let Err(e) = job_queue
+        .submit_and_wait_for_completion(job, completion_budget)
+        .await
+    {
+        error!(
+            "Worker removal did not complete for {}: {}",
+            worker_url, e
         );
+        return false;
     }
+
+    debug!("Worker removal completed for {}", worker_url);
+
+    // Only now is the registration dropped, because the removal was handed over.
+    // Guarded on the exact PodInfo so a concurrent update for the same UID, which
+    // registered a different PodInfo while the removal was in flight, is not silently
+    // discarded.
+    let remaining = {
+        let mut tracker = match tracked_pods.lock() {
+            Ok(tracker) => tracker,
+            Err(e) => {
+                error!("Failed to acquire tracked_pods lock during removal: {}", e);
+                return false;
+            }
+        };
+        if tracker
+            .get(&registered.uid)
+            .is_some_and(|current| current == registered)
+        {
+            tracker.remove(&registered.uid);
+        }
+        tracker.len()
+    };
+
+    // Layer 4: Record deregistration from K8s pod deletion
+    Metrics::record_discovery_deregistration(
+        metrics_labels::DISCOVERY_KUBERNETES,
+        metrics_labels::DEREGISTRATION_POD_DELETED,
+    );
+
+    // Update workers discovered gauge
+    Metrics::set_discovery_workers_discovered(metrics_labels::DISCOVERY_KUBERNETES, remaining);
+
+    true
 }
 
