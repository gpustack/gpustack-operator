+    /// Query one prefiller's Mooncake bootstrap server and cache the result under
+    /// the prefiller's URL.
+    ///
+    /// The bootstrap port comes from the worker registry, where Kubernetes service
+    /// discovery stored the Pod's bootstrap-port annotation when it registered the
+    /// worker; it falls back to 8998, the same default the construction path uses.
+    /// A failure is NOT cached, so the next request retries - which is also what
+    /// picks up a prefiller that restarted with a new engine id at the same URL.
+    /// Concurrent misses may query twice; both write the same value.
+    async fn query_and_cache_mooncake_info(&self, prefill_url: &str) -> Option<()> {
+        let parsed = match url::Url::parse(prefill_url) {
+            Ok(parsed) => parsed,
+            Err(e) => {
+                warn!(
+                    "Cannot parse prefill URL '{}' for Mooncake bootstrap query: {}",
+                    prefill_url, e
+                );
+                return None;
+            }
+        };
+        let host = match parsed.host() {
+            // Bracket an IPv6 literal so the address stays valid once a port is appended.
+            Some(url::Host::Ipv6(addr)) => format!("[{}]", addr),
+            Some(url::Host::Domain(domain)) => domain.to_string(),
+            Some(url::Host::Ipv4(addr)) => addr.to_string(),
+            None => {
+                warn!(
+                    "Prefill URL '{}' has no host for Mooncake bootstrap query",
+                    prefill_url
+                );
+                return None;
+            }
+        };
+        let bootstrap_port = self
+            .pd_router
+            .worker_registry
+            .get_prefill_workers()
+            .iter()
+            .find(|w| w.base_url() == prefill_url)
+            .and_then(|w| match w.worker_type() {
+                WorkerType::Prefill { bootstrap_port } => bootstrap_port,
+                _ => None,
+            })
+            .unwrap_or(8998);
+        let bootstrap_addr = format!("http://{}:{}", host, bootstrap_port);
+
+        match Self::query_mooncake_bootstrap(&self.http_client, &bootstrap_addr, 3).await {
+            Ok(dp_engine_ids) => {
+                info!(
+                    "Lazily queried Mooncake bootstrap at {} for prefill {}: {} dp ranks found",
+                    bootstrap_addr,
+                    prefill_url,
+                    dp_engine_ids.len()
+                );
+                self.mooncake_prefill_info.lock().await.insert(
+                    prefill_url.to_string(),
+                    MooncakePrefillInfo {
+                        bootstrap_addr,
+                        dp_engine_ids,
+                    },
+                );
+                Some(())
+            }
+            Err(e) => {
+                warn!(
+                    "Failed to query Mooncake bootstrap for prefill {}: {}",
+                    prefill_url, e
+                );
+                None
+            }
+        }
+    }
+
