+    /// Read the effective state without changing native routing state.
+    pub fn observe_effective(&self) -> (CircuitState, bool) {
+        let state_guard = self.state.read().unwrap();
+        let last_change = *self.last_state_change.read().unwrap();
+        let effective = match *state_guard {
+            CircuitState::Open if last_change.elapsed() >= self.config.timeout_duration => {
+                CircuitState::HalfOpen
+            }
+            other => other,
+        };
+        let would_allow = !matches!(effective, CircuitState::Open);
+        (effective, would_allow)
+    }
