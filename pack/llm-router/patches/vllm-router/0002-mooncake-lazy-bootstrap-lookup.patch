+    #[tokio::test]
+    async fn mooncake_port_change_evicts_old_port_without_touching_sibling_ranks() {
+        let base_url = spawn_test_server(
+            axum::Router::new()
+                .route("/health", axum::routing::get(|| async { StatusCode::OK }))
+                .route(
+                    "/v1/models",
+                    axum::routing::get(|| async { axum::Json(json!({"data": [{"id": "m"}]})) }),
+                )
+                .fallback(|| async { StatusCode::OK }),
+        )
+        .await;
+        let mut router = test_vllm_pd_router().await;
+        router.kv_connector = KvConnector::Mooncake;
+
+        let rank0_url = format!("{base_url}@0");
+        let rank0: Arc<dyn Worker> = Arc::new(DPAwareWorker::new(
+            base_url.clone(),
+            0,
+            2,
+            WorkerType::Prefill {
+                bootstrap_port: Some(9000),
+            },
+        ));
+        let rank1: Arc<dyn Worker> = Arc::new(DPAwareWorker::new(
+            base_url.clone(),
+            1,
+            2,
+            WorkerType::Prefill {
+                bootstrap_port: Some(9001),
+            },
+        ));
+        router.pd_router.worker_registry.register(rank0);
+        router.pd_router.worker_registry.register(rank1.clone());
+
+        for (port, engine) in [
+            (MOONCAKE_DEFAULT_BOOTSTRAP_PORT, "default-port"),
+            (9000_u16, "rank0-old"),
+            (9001, "rank1-keep"),
+            (9002, "rank0-stale-new"),
+        ] {
+            router
+                .mooncake_prefill_info
+                .write()
+                .unwrap()
+                .entry(port)
+                .or_default()
+                .insert(
+                    base_url.clone(),
+                    MooncakePrefillInfo {
+                        bootstrap_addr: format!("http://127.0.0.1:{port}"),
+                        dp_engine_ids: HashMap::from([
+                            (0, format!("{engine}-0")),
+                            (1, format!("{engine}-1")),
+                        ]),
+                        fallback_warning: Arc::new(Once::new()),
+                    },
+                );
+        }
+
+        // Re-adding rank 0 with a new bootstrap port evicts both its old (9000) and new (9002)
+        // entries while keeping sibling rank 1's cached metadata on port 9001 intact.
+        let _ = router.add_prefill_server(rank0_url, Some(9002)).await;
+        assert!(!router.has_mooncake_entry(&base_url, 9000));
+        assert!(!router.has_mooncake_entry(&base_url, 9002));
+        assert_eq!(
+            router.get_mooncake_info(&base_url, Some(9001), Some(1)),
+            Some((
+                "http://127.0.0.1:9001".to_string(),
+                "rank1-keep-1".to_string()
+            ))
+        );
+
+        // A sibling rank using the default port (None -> 8998) resolves 8998 directly rather
+        // than hijacking rank 1's custom port 9001 from worker_registry.
+        let default_port_sibling = DPAwareWorker::new(
+            base_url.clone(),
+            0,
+            2,
+            WorkerType::Prefill {
+                bootstrap_port: None,
+            },
+        );
+        assert_eq!(
+            router
+                .build_decode_kv_transfer_params(&default_port_sibling, None, Some("xfer"), None)
+                .await
+                .unwrap()["remote_engine_id"],
+            "default-port-0"
+        );
+        assert_eq!(
+            router
+                .build_decode_kv_transfer_params(rank1.as_ref(), None, Some("xfer"), None)
+                .await
+                .unwrap()["remote_engine_id"],
+            "rank1-keep-1"
+        );
+    }
