+                .fallback(|| async { StatusCode::OK }),
+        )
+        .await;
+        let bootstrap_port = url::Url::parse(&bootstrap_url).unwrap().port().unwrap();
+        let prefill_url = spawn_test_server(
+            axum::Router::new()
+                .route("/health", axum::routing::get(|| async { StatusCode::OK }))
+                .route(
+                    "/v1/models",
+                    axum::routing::get(|| async { axum::Json(json!({"data": [{"id": "m"}]})) }),
+                )
+                .fallback(|| async { StatusCode::OK }),
+        )
+        .await;
+
+        let mut router = test_vllm_pd_router().await;
+        router.kv_connector = KvConnector::Mooncake;
+        router
+            .add_prefill_server(prefill_url.clone(), Some(bootstrap_port))
+            .await
+            .unwrap();
+        assert_eq!(queries.load(Ordering::SeqCst), 0);
+
+        let workers = router.pd_router.worker_registry.get_prefill_workers();
+        assert_eq!(workers.len(), 1);
+        for _ in 0..2 {
+            let params = router
+                .build_decode_kv_transfer_params(
+                    workers[0].as_ref(),
+                    None,
+                    Some("xfer-lazy"),
+                    Some("req-lazy"),
+                )
+                .await
+                .unwrap();
+            assert_eq!(params["remote_bootstrap_addr"], bootstrap_url);
+            assert_eq!(params["remote_engine_id"], "lazy-gen-1-rank-0");
+        }
+        assert_eq!(queries.load(Ordering::SeqCst), 1);
+
+        // Removing and re-registering the prefiller evicts cached Mooncake metadata so a
+        // restarted prefiller at the same URL is queried again for its new engine_id.
+        generation.store(2, Ordering::SeqCst);
+        router.remove_prefill_server(&prefill_url).await.unwrap();
+        assert!(router
+            .get_mooncake_info(&prefill_url, Some(bootstrap_port), Some(0))
+            .is_none());
+        router
+            .add_prefill_server(prefill_url.clone(), Some(bootstrap_port))
+            .await
+            .unwrap();
+        let refreshed = router.pd_router.worker_registry.get_prefill_workers();
+        let params = router
+            .build_decode_kv_transfer_params(
+                refreshed[0].as_ref(),
+                None,
+                Some("xfer-lazy-2"),
+                Some("req-lazy-2"),
+            )
+            .await
+            .unwrap();
+        assert_eq!(params["remote_bootstrap_addr"], bootstrap_url);
+        assert_eq!(params["remote_engine_id"], "lazy-gen-2-rank-0");
+        assert_eq!(queries.load(Ordering::SeqCst), 2);
+
+        // WorkerManagement::remove_worker (/remove_worker HTTP handler path) also evicts
+        // cached Mooncake bootstrap metadata and forces a fresh lazy lookup on the next request.
+        generation.store(3, Ordering::SeqCst);
+        WorkerManagement::remove_worker(&router, &prefill_url);
+        assert!(router
+            .get_mooncake_info(&prefill_url, Some(bootstrap_port), Some(0))
+            .is_none());
+        router
+            .add_prefill_server(prefill_url.clone(), Some(bootstrap_port))
+            .await
+            .unwrap();
+        let readded = router.pd_router.worker_registry.get_prefill_workers();
+        let params = router
+            .build_decode_kv_transfer_params(
+                readded[0].as_ref(),
+                None,
+                Some("xfer-lazy-3"),
+                Some("req-lazy-3"),
+            )
+            .await
+            .unwrap();
+        assert_eq!(params["remote_bootstrap_addr"], bootstrap_url);
+        assert_eq!(params["remote_engine_id"], "lazy-gen-3-rank-0");
+        assert_eq!(queries.load(Ordering::SeqCst), 3);
+    }
