new file mode 100644
index 0000000..45d030e
--- /dev/null
+++ b/pkg/epp/observer/endpoints_test.go
@@ -0,0 +1,165 @@
+// Copyright 2026 The Kubernetes Authors.
+// SPDX-License-Identifier: Apache-2.0
+package observer
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+	"time"
+
+	fwkdl "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/datalayer"
+	fwkplugin "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/plugin"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+type testStore struct {
+	metas []*fwkdl.EndpointMetadata
+	err   error
+}
+
+func (s *testStore) ObserverSnapshot() ([]*fwkdl.EndpointMetadata, uint64, error) {
+	return s.metas, 4, s.err
+}
+func testMetadata() *fwkdl.EndpointMetadata {
+	return &fwkdl.EndpointMetadata{ID: types.NamespacedName{Namespace: "ns", Name: "worker-rank-0"}, Name: "worker", Address: "192.0.2.1", Port: "8000", Labels: map[string]string{"app.kubernetes.io/component": "custom-role"}}
+}
+func readView(t *testing.T, o *Observer) (int, view) {
+	t.Helper()
+	r := httptest.NewRecorder()
+	o.ServeHTTP(r, httptest.NewRequest(http.MethodGet, Path, nil))
+	var result view
+	if r.Code == http.StatusOK {
+		if err := json.Unmarshal(r.Body.Bytes(), &result); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return r.Code, result
+}
+func TestObserverMembershipAndPendingDispatch(t *testing.T) {
+	now := time.Now()
+	meta := testMetadata()
+	store := &testStore{metas: []*fwkdl.EndpointMetadata{meta}}
+	o := New(store, func() bool { return true })
+	o.now = func() time.Time { return now }
+	before := meta.Clone()
+	code, result := readView(t, o)
+	if code != 200 || len(result.Workers) != 1 || !result.Workers[0].Selection.InSelection {
+		t.Fatalf("registered listener: %d %+v", code, result)
+	}
+	boot := result.Router.Boot
+	window := o.Begin()
+	window.Record(meta)
+	store.metas = nil
+	if code, _ := readView(t, o); code != 503 {
+		t.Fatalf("pending copied endpoint accepted: %d", code)
+	}
+	window.Finish()
+	window.Finish()
+	code, result = readView(t, o)
+	if code != 200 || len(result.Workers) != 1 || result.Workers[0].Selection.InSelection || result.Workers[0].LastJob == nil || !result.Workers[0].LastJob.Recent {
+		t.Fatalf("removed dispatched endpoint was lost or fabricated registered: %d %+v", code, result)
+	}
+	if !reflect.DeepEqual(before, meta) {
+		t.Fatal("observer changed native endpoint")
+	}
+	now = now.Add(freshness - time.Nanosecond)
+	if _, result := readView(t, o); len(result.Workers) != 1 {
+		t.Fatal("recent dispatch expired early")
+	}
+	now = now.Add(time.Nanosecond)
+	code, result = readView(t, o)
+	if code != 200 || result.Workers == nil || len(result.Workers) != 0 || result.Router.Boot != boot {
+		t.Fatalf("honest zero: %d %+v", code, result)
+	}
+	if len(o.recent) != 1 {
+		t.Fatal("GET mutated journal")
+	}
+}
+func TestObserverRefusesIncompleteCoverage(t *testing.T) {
+	tests := []struct {
+		name           string
+		unavailable    bool
+		missingStore   bool
+		storeErr       bool
+		brokenMetadata bool
+		want           int
+	}{
+		{name: "supported empty", want: 200}, {name: "uncovered flow or plugin", unavailable: true, want: 503},
+		{name: "missing datastore", missingStore: true, want: 503}, {name: "pool resync incomplete", storeErr: true, want: 503},
+		{name: "invalid native listener", brokenMetadata: true, want: 503},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			store := &testStore{}
+			if tt.storeErr {
+				store.err = errors.New("resync incomplete")
+			}
+			if tt.brokenMetadata {
+				meta := testMetadata()
+				meta.Port = "bad"
+				store.metas = []*fwkdl.EndpointMetadata{meta}
+			}
+			var snapshotter Snapshotter = store
+			if tt.missingStore {
+				snapshotter = nil
+			}
+			o := New(snapshotter, func() bool { return !tt.unavailable })
+			if code, _ := readView(t, o); code != tt.want {
+				t.Fatalf("code=%d want=%d", code, tt.want)
+			}
+		})
+	}
+}
+func TestObserverRetainsAuxiliaryAndOldTransport(t *testing.T) {
+	meta := testMetadata()
+	other := meta.Clone()
+	other.ID.Name = "prefill-rank-0"
+	other.Name = "prefill"
+	other.Address = "192.0.2.2"
+	other.Labels["app.kubernetes.io/component"] = "prefill-role"
+	store := &testStore{}
+	o := New(store, func() bool { return true })
+	window := o.Begin()
+	window.Record(meta)
+	window.Record(other)
+	window.Finish()
+	changed := meta.Clone()
+	changed.Port = "8001"
+	store.metas = []*fwkdl.EndpointMetadata{changed}
+	code, result := readView(t, o)
+	if code != 200 || len(result.Workers) != 3 {
+		t.Fatalf("lost auxiliary or old listener: %d %+v", code, result)
+	}
+}
+
+type testPlugin string
+
+func (p testPlugin) TypedName() fwkplugin.TypedName {
+	return fwkplugin.TypedName{Type: string(p), Name: string(p)}
+}
+func TestObserverPluginCoverage(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		types []string
+		want  bool
+	}{
+		{name: "missing", want: false}, {name: "operator default", types: []string{"single-profile-handler", "label-selector-filter", "queue-scorer", "kv-cache-utilization-scorer", "max-score-picker", "prefix-cache-scorer", "metrics-data-source", "core-metrics-extractor", "approx-prefix-cache-producer"}, want: true},
+		{name: "operator disaggregation", types: []string{"disagg-profile-handler", "prefix-based-pd-decider", "precise-prefix-cache-producer", "token-producer", "endpoint-notification-source"}, want: true},
+		{name: "unknown plugin", types: []string{"single-profile-handler", "retains-private-candidates"}, want: false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			h := fwkplugin.NewEppHandle(context.Background(), nil)
+			for _, kind := range tt.types {
+				h.AddPlugin(kind, testPlugin(kind))
+			}
+			if SupportedPlugins(h) != tt.want {
+				t.Fatal("coverage mismatch")
+			}
+		})
+	}
+}
