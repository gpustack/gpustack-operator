+)
+
+// Fixtures come from the operator's router.Render, including native system defaults.
+func TestObserverSupportsRenderedOperatorProfiles(t *testing.T) {
+	for _, name := range []string{"server", "pd"} {
+		t.Run(name, func(t *testing.T) {
+			data, err := os.ReadFile("observer_testdata/" + name + ".yaml")
+			if err != nil {
+				t.Fatal(err)
+			}
+			runner := NewRunner()
+			opts := runserver.NewOptions()
+			opts.ConfigText = string(data)
+			raw, err := runner.parseConfigurationPhaseOne(context.Background(), opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ds := datastore.NewDatastore(t.Context(), nil)
+			if _, err := runner.parseConfigurationPhaseTwo(t.Context(), raw, ds); err != nil {
+				t.Fatal(err)
+			}
+			if !observer.SupportedPlugins(runner.PluginHandle) {
+				for _, plugin := range runner.PluginHandle.GetAllPlugins() {
+					t.Log(plugin.TypedName())
+				}
+				t.Fatal("actual rendered operator profile is refused")
+			}
+		})
+	}
+}
