@@ -0,0 +1,117 @@
+// Copyright 2026 The Kubernetes Authors.
+// SPDX-License-Identifier: Apache-2.0
+package runner
+
+import (
+	"context"
+	"os"
+	"slices"
+	"testing"
+
+	"github.com/llm-d/llm-d-router/pkg/epp/datastore"
+	"github.com/llm-d/llm-d-router/pkg/epp/observer"
+	runserver "github.com/llm-d/llm-d-router/pkg/epp/server"
+)
+
+// Fixtures come from the operator's router.Render, including native system defaults.
+func TestObserverSupportsRenderedOperatorProfiles(t *testing.T) {
+	cases := []struct {
+		name      string
+		checkRefs func(t *testing.T, profiles map[string][]string)
+	}{
+		{name: "server"},
+		{
+			name: "server_external_dp",
+			checkRefs: func(t *testing.T, profiles map[string][]string) {
+				want := []string{
+					"server-pods",
+					"endpoint-health-filter",
+					"queue-scorer",
+					"kv-cache-utilization-scorer",
+					"max-score-picker",
+					"utilization-detector",
+				}
+				if !slices.Equal(profiles["server"], want) {
+					t.Fatalf("external-dp server profile = %v, want %v", profiles["server"], want)
+				}
+				if slices.Contains(profiles["server"], "prefix-cache-scorer") {
+					t.Fatalf("external-dp server profile must omit prefix-cache-scorer: %v", profiles["server"])
+				}
+			},
+		},
+		{
+			name: "server_unmanaged",
+			checkRefs: func(t *testing.T, profiles map[string][]string) {
+				if !slices.Contains(profiles["server"], "endpoint-health-filter") {
+					t.Fatalf("unmanaged server profile missing endpoint-health-filter: %v", profiles["server"])
+				}
+			},
+		},
+		{name: "pd"},
+		{
+			name: "pd_precise",
+			checkRefs: func(t *testing.T, profiles map[string][]string) {
+				for _, profile := range []string{"decode", "prefill"} {
+					if !slices.Contains(profiles[profile], "endpoint-health-filter") {
+						t.Fatalf("%s profile missing endpoint-health-filter: %v", profile, profiles[profile])
+					}
+				}
+			},
+		},
+		{
+			name: "epd",
+			checkRefs: func(t *testing.T, profiles map[string][]string) {
+				for _, profile := range []string{"decode", "prefill"} {
+					if !slices.Contains(profiles[profile], "endpoint-health-filter") {
+						t.Fatalf("%s profile missing endpoint-health-filter: %v", profile, profiles[profile])
+					}
+				}
+				if slices.Contains(profiles["encode"], "endpoint-health-filter") {
+					t.Fatalf("encode profile must not attach endpoint-health-filter: %v", profiles["encode"])
+				}
+			},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			data, err := os.ReadFile("observer_testdata/" + tc.name + ".yaml")
+			if err != nil {
+				t.Fatal(err)
+			}
+			runner := NewRunner()
+			opts := runserver.NewOptions()
+			opts.ConfigText = string(data)
+			epf := runner.setupMetricsCollection(opts)
+			raw, err := runner.parseConfigurationPhaseOne(context.Background(), opts)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ds := datastore.NewDatastore(t.Context(), epf)
+			cfg, err := runner.parseConfigurationPhaseTwo(t.Context(), raw, ds, opts.RefreshMetricsInterval)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := runner.dlRuntime.Configure(cfg.DataConfig, setupLog); err != nil {
+				t.Fatal(err)
+			}
+			if !observer.SupportedPlugins(runner.PluginHandle) {
+				for _, plugin := range runner.PluginHandle.GetAllPlugins() {
+					t.Log(plugin.TypedName())
+				}
+				t.Fatal("actual rendered operator profile is refused")
+			}
+			if tc.checkRefs != nil {
+				profiles := make(map[string][]string, len(raw.SchedulingProfiles))
+				for _, prof := range raw.SchedulingProfiles {
+					refs := make([]string, 0, len(prof.Plugins))
+					for _, p := range prof.Plugins {
+						refs = append(refs, p.PluginRef)
+					}
+					profiles[prof.Name] = refs
+				}
+				tc.checkRefs(t, profiles)
+			}
+		})
+	}
+}
