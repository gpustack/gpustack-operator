+}
+
+// TestObserverRecordsNativeDirectorAuxiliaryTargets asserts that Director.HandleRequest
+// records every ProfileRunResult TargetEndpoint into the observer window (primary +
+// auxiliary profiles), and that the observer view then carries recent_dispatch for
+// each recorded target.
+func TestObserverRecordsNativeDirectorAuxiliaryTargets(t *testing.T) {
+	makeEndpoint := func(name, address, role string) fwksched.Endpoint {
+		return fwksched.NewEndpoint(&fwkdl.EndpointMetadata{ID: types.NamespacedName{Name: name, Namespace: "ns"}, Name: name, Address: address, Port: "8000", Labels: map[string]string{"app.kubernetes.io/component": role}}, nil, fwkdl.NewAttributes())
+	}
+	result := &fwksched.SchedulingResult{PrimaryProfileName: "decode", ProfileResults: map[string]*fwksched.ProfileRunResult{
+		"decode":  {TargetEndpoints: []fwksched.Endpoint{makeEndpoint("decoder", "192.0.2.1", "decode-role")}},
+		"prefill": {TargetEndpoints: []fwksched.Endpoint{makeEndpoint("prefiller", "192.0.2.2", "prefill-role")}},
+	}}
+	mockSched := &mockScheduler{scheduleResults: result}
+
+	ctx := t.Context()
+	epf := datalayer.NewTestRuntime(t, time.Minute)
+	ds := datastore.NewDatastore(ctx, epf)
+	ds.WithEndpointPool(&datalayer.EndpointPool{TargetPorts: []int{8000}})
+	ds.EndpointUpsert(ctx, &fwkdl.EndpointMetadata{ID: types.NamespacedName{Name: "decoder", Namespace: "ns"}, Name: "decoder", Address: "192.0.2.1", Port: "8000", Labels: map[string]string{"app.kubernetes.io/component": "decode-role"}})
+	ds.EndpointUpsert(ctx, &fwkdl.EndpointMetadata{ID: types.NamespacedName{Name: "prefiller", Namespace: "ns"}, Name: "prefiller", Address: "192.0.2.2", Port: "8000", Labels: map[string]string{"app.kubernetes.io/component": "prefill-role"}})
+	endpointCandidates := NewDatastoreEndpointCandidates(ds)
+	director := NewDirectorWithConfig(ds, mockSched, &mockAdmissionController{}, endpointCandidates, NewConfig(), "")
+
+	o := observer.New(observedStore{}, func() bool { return true })
+	req := &handlers.RequestContext{
+		ObserverWindow: o.Begin(),
+		Request:        &handlers.Request{Headers: map[string]string{":path": "/v1/completions"}, RawBody: []byte(`{"model":"m","prompt":"p"}`)},
+		Parser:         openai.NewOpenAIParser(),
+	}
+	defer req.ObserverWindow.Finish()
+
+	parsed, err := req.Parser.ParseRequest(ctx, req.Request.RawBody, req.Request.Headers)
+	if err != nil {
+		t.Fatal(err)
+	}
+	returned, err := director.HandleRequest(ctx, req, parsed.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if returned.TargetPod == nil || returned.TargetPod.Name != "decoder" {
+		t.Fatal("native primary routing was changed")
+	}
+	req.ObserverWindow.Finish()
+
+	recorder := httptest.NewRecorder()
+	o.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, observer.Path, nil))
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("observer refused: %d %s", recorder.Code, recorder.Body.String())
+	}
+	var observed struct {
+		Workers []struct {
+			PodHint string `json:"pod_hint"`
+			LastJob struct {
+				Recent bool `json:"recent_dispatch"`
+			} `json:"last_job"`
+		} `json:"workers"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &observed); err != nil {
+		t.Fatal(err)
+	}
+	if len(observed.Workers) != 2 {
+		t.Fatalf("native primary/auxiliary target lost: %s", recorder.Body.String())
+	}
+	for _, worker := range observed.Workers {
+		if !worker.LastJob.Recent {
+			t.Fatalf("native target %q has no dispatch evidence", worker.PodHint)
+		}
+	}
+}
