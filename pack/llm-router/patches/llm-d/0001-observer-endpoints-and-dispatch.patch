index 0000000000000000000000000000000000000000..9e676a90c628cbde9c6f90ae019c6a6195b028bc
--- /dev/null
+++ b/pkg/epp/datastore/observer_lock_order_test.go
@@ -0,0 +1,119 @@
+// Copyright 2026 The Kubernetes Authors.
+// SPDX-License-Identifier: Apache-2.0
+package datastore
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/llm-d/llm-d-router/pkg/epp/datalayer"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/labels"
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+	"sigs.k8s.io/controller-runtime/pkg/client/interceptor"
+)
+
+func selectorFromLabels(s string) labels.Selector {
+	sel, _ := labels.Parse(s)
+	return sel
+}
+
+// TestObserverSnapshotVsPoolSet_NoDeadlock pins the lock-order invariant between
+// ObserverSnapshot (observerMu.RLock then ds.mu.RLock) and PoolSet/podResyncAll/
+// podUpdateOrAddIfNotExist (ds.mu.Lock then no further observerMu acquisition).
+//
+// ObserverSnapshot's order: observerMu -> ds.mu.
+// PoolSet's order: ds.mu -> podUpdateOrAddIfNotExist (which must NOT touch
+// observerMu while ds.mu is held by the caller).
+//
+// Regression: any future change that re-introduces an observerMu acquisition
+// inside podUpdateOrAddIfNotExist will deadlock the test within ~5s. The
+// signal is the two goroutines both blocked on a mutex at the same time,
+// observed here by gating PoolSet's podResyncAll.List call on a channel so
+// the goroutine is parked inside ds.mu while ObserverSnapshot takes observerMu.
+func TestObserverSnapshotVsPoolSet_NoDeadlock(t *testing.T) {
+	const deadline = 5 * time.Second
+
+	releaseList := make(chan struct{})
+	listEntered := make(chan struct{})
+	var enteredOnce sync.Once
+
+	readyPod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "pod-0",
+			Namespace: "default",
+			Labels:    map[string]string{"app": "model"},
+		},
+		Status: corev1.PodStatus{
+			Conditions: []corev1.PodCondition{{Type: corev1.PodReady, Status: corev1.ConditionTrue}},
+		},
+	}
+	fakeClient := fake.NewClientBuilder().
+		WithObjects(readyPod).
+		WithInterceptorFuncs(interceptor.Funcs{
+			List: func(ctx context.Context, c client.WithWatch, list client.ObjectList, opts ...client.ListOption) error {
+				enteredOnce.Do(func() { close(listEntered) })
+				<-releaseList
+				return c.List(ctx, list, opts...)
+			},
+		}).
+		Build()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	ds := NewDatastore(ctx, &mockEndpointFactory{}).(*datastore)
+	pool := &datalayer.EndpointPool{
+		TargetPorts: []int{8000},
+		Selector:    selectorFromLabels("app=model"),
+	}
+
+	// Goroutine A: run PoolSet so it parks inside podResyncAll.List while
+	// holding ds.mu.
+	poolSetDone := make(chan error, 1)
+	go func() {
+		poolSetDone <- ds.PoolSet(ctx, fakeClient, pool)
+	}()
+
+	// Wait until A is parked in the List call.
+	select {
+	case <-listEntered:
+	case <-time.After(deadline):
+		t.Fatal("PoolSet never reached the List call")
+	}
+
+	// Goroutine B: take observerMu via ObserverSnapshot and block on ds.mu.RLock.
+	snapshotDone := make(chan struct{})
+	go func() {
+		defer close(snapshotDone)
+		for i := 0; i < 50; i++ {
+			_, _, _ = ds.ObserverSnapshot()
+		}
+	}()
+
+	// Give B time to acquire observerMu.TryRLock and block on ds.mu.RLock.
+	// 100ms is well below the 5s deadlock budget.
+	time.Sleep(100 * time.Millisecond)
+
+	// Release A's List call. With the bug, A will then enter
+	// podUpdateOrAddIfNotExist, try to Lock observerMu while holding ds.mu,
+	// and wedge against B's RLock. Without the bug, A finishes and B
+	// eventually drains.
+	close(releaseList)
+
+	select {
+	case err := <-poolSetDone:
+		if err != nil {
+			t.Fatalf("PoolSet failed: %v", err)
+		}
+	case <-snapshotDone:
+	case <-time.After(deadline):
+		t.Fatalf("deadlock: neither PoolSet nor ObserverSnapshot returned within %v; "+
+			"observerMu and ds.mu are inverted across the snapshot/resync boundary",
+			deadline)
+	}
+}
