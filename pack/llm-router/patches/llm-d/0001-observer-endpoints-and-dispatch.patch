@@ -0,0 +1,75 @@
+// Copyright 2026 The Kubernetes Authors.
+// SPDX-License-Identifier: Apache-2.0
+package datastore
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	"github.com/llm-d/llm-d-router/pkg/epp/datalayer"
+	fwkdl "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/datalayer"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+func TestObserverSnapshotOwnsMetadataAndRequiresSyncedPool(t *testing.T) {
+	ds := NewDatastore(context.Background(), &mockEndpointFactory{}).(*datastore)
+	if _, _, err := ds.ObserverSnapshot(); err == nil {
+		t.Fatal("unsynced store accepted")
+	}
+	ds.WithEndpointPool(&datalayer.EndpointPool{TargetPorts: []int{8000}})
+	meta := &fwkdl.EndpointMetadata{ID: types.NamespacedName{Name: "rank-0"}, Name: "worker", Address: "192.0.2.1", Port: "8000", Labels: map[string]string{"role": "server"}}
+	ds.EndpointUpsert(context.Background(), meta)
+	snapshot, revision, err := ds.ObserverSnapshot()
+	if err != nil || len(snapshot) != 1 || revision == 0 {
+		t.Fatalf("snapshot %v %v", snapshot, err)
+	}
+	snapshot[0].Labels["role"] = "mutated"
+	snapshot[0].Port = "bad"
+	if meta.Labels["role"] != "server" || meta.Port != "8000" {
+		t.Fatal("observer leaked native mutable metadata")
+	}
+	ds.mu.Lock()
+	ds.needsResync = true
+	ds.mu.Unlock()
+	if _, _, err := ds.ObserverSnapshot(); err == nil {
+		t.Fatal("failed resync accepted")
+	}
+	ds.mu.Lock()
+	ds.needsResync = false
+	ds.mu.Unlock()
+	ds.EndpointDelete(meta.ID)
+	snapshot, after, err := ds.ObserverSnapshot()
+	if err != nil || len(snapshot) != 0 || after <= revision {
+		t.Fatalf("native removal not observed: %v %d %v", snapshot, after, err)
+	}
+}
+func TestObserverSnapshotConcurrentMembership(t *testing.T) {
+	ds := NewDatastore(context.Background(), &mockEndpointFactory{}).(*datastore)
+	ds.WithEndpointPool(&datalayer.EndpointPool{})
+	var group sync.WaitGroup
+	group.Add(1)
+	go func() {
+		defer group.Done()
+		for i := 0; i < 200; i++ {
+			meta := &fwkdl.EndpointMetadata{ID: types.NamespacedName{Name: "rank-0"}, Name: "worker", Port: "8000", Labels: map[string]string{"role": "server"}}
+			ds.EndpointUpsert(context.Background(), meta)
+			ds.EndpointDelete(meta.ID)
+		}
+	}()
+	for i := 0; i < 200; i++ {
+		metas, _, err := ds.ObserverSnapshot()
+		if err != nil {
+			continue
+		}
+		if len(metas) > 1 {
+			t.Fatalf("mixed snapshot %v %v", metas, err)
+		}
+		for _, meta := range metas {
+			if meta.Port != "8000" || meta.Labels["role"] != "server" {
+				t.Fatal("partial metadata")
+			}
+		}
+	}
+	group.Wait()
+}
