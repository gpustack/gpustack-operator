+	fwkdl "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/datalayer"
+	"github.com/llm-d/llm-d-router/pkg/epp/observer"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+type observedStore struct {
+	mu   sync.Mutex
+	meta *fwkdl.EndpointMetadata
+}
+
+func (s *observedStore) ObserverSnapshot() ([]*fwkdl.EndpointMetadata, uint64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.meta == nil {
+		return nil, 1, nil
+	}
+	return []*fwkdl.EndpointMetadata{s.meta.Clone()}, 1, nil
+}
+
+type observedDirector struct {
+	Director
+	meta    *fwkdl.EndpointMetadata
+	entered bool
+}
+
+func (d *observedDirector) GetRandomEndpoint() *fwkdl.EndpointMetadata {
+	d.entered = true
+	return d.meta
+}
+
+type blockedObserverStream struct {
+	mockProcessServer
+	ctx      context.Context
+	received bool
+	entered  chan struct{}
+	release  chan struct{}
+	sent     chan struct{}
+}
+
+func (s *blockedObserverStream) Context() context.Context { return s.ctx }
+func (s *blockedObserverStream) Recv() (*extProcPb.ProcessingRequest, error) {
+	if s.received {
+		<-s.ctx.Done()
+		return nil, io.EOF
+	}
+	s.received = true
+	return &extProcPb.ProcessingRequest{Request: &extProcPb.ProcessingRequest_RequestHeaders{RequestHeaders: &extProcPb.HttpHeaders{Headers: &configPb.HeaderMap{}, EndOfStream: true}}}, nil
+}
+func (s *blockedObserverStream) Send(r *extProcPb.ProcessingResponse) error {
+	close(s.entered)
+	<-s.release
+	err := s.mockProcessServer.Send(r)
+	close(s.sent)
+	return err
+}
+func TestObserverCoversActualProcessPendingSend(t *testing.T) {
+	meta := &fwkdl.EndpointMetadata{ID: types.NamespacedName{Name: "rank-0"}, Name: "worker", Address: "192.0.2.1", Port: "8000", Labels: map[string]string{"app.kubernetes.io/component": "custom"}}
+	store := &observedStore{meta: meta}
+	o := observer.New(store, func() bool { return true })
+	director := &observedDirector{meta: meta}
+	server := NewStreamingServer(nil, director, nil, 0)
+	server.SetObserver(o)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	stream := &blockedObserverStream{ctx: ctx, entered: make(chan struct{}), release: make(chan struct{}), sent: make(chan struct{})}
+	done := make(chan error, 1)
+	go func() { defer close(done); done <- server.Process(stream) }()
+	var releaseOnce sync.Once
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(stream.release) })
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Error("native stream leaked")
+		}
+	})
+	select {
+	case <-stream.entered:
+	case <-time.After(time.Second):
+		t.Fatal("actual native Send was not reached")
+	}
+	if !director.entered {
+		t.Fatal("native random candidate was not read")
+	}
+	store.mu.Lock()
+	store.meta = nil
+	store.mu.Unlock()
+	r := httptest.NewRecorder()
+	o.ServeHTTP(r, httptest.NewRequest("GET", observer.Path, nil))
+	if r.Code != 503 {
+		t.Fatalf("copied pending Send accepted after datastore removal: %d", r.Code)
+	}
+	releaseOnce.Do(func() { close(stream.release) })
+	<-stream.sent
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("native stream did not finish")
+	}
+	r = httptest.NewRecorder()
+	o.ServeHTTP(r, httptest.NewRequest("GET", observer.Path, nil))
+	var result struct {
+		Workers []struct {
+			Selection struct {
+				InSelection bool `json:"in_selection"`
+			} `json:"selection"`
+			LastJob struct {
+				Recent bool `json:"recent_dispatch"`
+			} `json:"last_job"`
+		} `json:"workers"`
+	}
+	if err := json.Unmarshal(r.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	if r.Code != 200 || len(result.Workers) != 1 || result.Workers[0].Selection.InSelection || !result.Workers[0].LastJob.Recent {
+		t.Fatalf("sent old endpoint was lost: %d %s", r.Code, r.Body.String())
+	}
+}
