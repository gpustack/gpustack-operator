+func (s *StreamingServer) SetObserver(o *observer.Observer) { s.observer = o }
diff --git a/pkg/epp/observer/endpoints.go b/pkg/epp/observer/endpoints.go
new file mode 100644
index 0000000..14f6a62
--- /dev/null
+++ b/pkg/epp/observer/endpoints.go
@@ -0,0 +1,261 @@
+// Copyright 2026 The Kubernetes Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+// Package observer exposes membership without changing native routing decisions.
+package observer
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"sort"
+	"strconv"
+	"sync"
+	"time"
+
+	fwkdl "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/datalayer"
+	fwkplugin "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/plugin"
+)
+
+const Path = "/observer/endpoints"
+const freshness = 15 * time.Second
+
+type Snapshotter interface {
+	ObserverSnapshot() ([]*fwkdl.EndpointMetadata, uint64, error)
+}
+
+type dispatch struct {
+	meta *fwkdl.EndpointMetadata
+	at   time.Time
+}
+
+// Observer shares the native selection-to-send window with the admin handler.
+type Observer struct {
+	mu        sync.Mutex
+	store     Snapshotter
+	supported func() bool
+	now       func() time.Time
+	boot      uint64
+	epoch     uint64
+	active    uint64
+	recent    map[string]dispatch
+}
+
+func New(store Snapshotter, supported func() bool) *Observer {
+	return &Observer{store: store, supported: supported, now: time.Now,
+		boot: uint64(time.Now().UnixNano()), recent: make(map[string]dispatch)}
+}
+
+// SupportedPlugins limits coverage to the operator's pinned native plugins.
+func SupportedPlugins(handle fwkplugin.HandlePlugins) bool {
+	if handle == nil {
+		return false
+	}
+	plugins := handle.GetAllPluginsWithNames()
+	if len(plugins) == 0 {
+		return false
+	}
+	for _, plugin := range plugins {
+		if plugin == nil {
+			return false
+		}
+		switch plugin.TypedName().Type {
+		case "label-selector-filter", "queue-scorer", "kv-cache-utilization-scorer",
+			"max-score-picker", "prefix-cache-scorer", "metrics-data-source",
+			"core-metrics-extractor", "approx-prefix-cache-producer",
+			"precise-prefix-cache-producer", "token-producer", "endpoint-notification-source",
+			"prefix-based-pd-decider", "disagg-profile-handler", "single-profile-handler",
+			"openai-parser", "anthropic-parser", "vllmhttp-parser",
+			"fcfs-ordering-policy", "global-strict-fairness-policy",
+			"static-usage-limit-policy-type", "utilization-detector":
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+// Window covers copies of candidates and routing responses until the native send ends.
+type Window struct {
+	owner    *Observer
+	targets  map[string]*fwkdl.EndpointMetadata
+	finished bool
+}
+
+func (o *Observer) Begin() *Window {
+	if o == nil {
+		return nil
+	}
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	o.active++
+	o.epoch++
+	return &Window{owner: o, targets: make(map[string]*fwkdl.EndpointMetadata)}
+}
+
+func endpointKey(meta *fwkdl.EndpointMetadata) string {
+	return meta.ID.String() + "|" + meta.Address + "|" + meta.Port
+}
+
+// Record preserves the actual native primary and auxiliary dispatch targets.
+func (w *Window) Record(meta *fwkdl.EndpointMetadata) {
+	if w == nil || meta == nil {
+		return
+	}
+	w.owner.mu.Lock()
+	defer w.owner.mu.Unlock()
+	if !w.finished {
+		w.targets[endpointKey(meta)] = meta.Clone()
+	}
+}
+
+// Finish retains recent targets while releasing the pending native send window.
+func (w *Window) Finish() {
+	if w == nil {
+		return
+	}
+	o := w.owner
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if w.finished {
+		return
+	}
+	w.finished = true
+	now := o.now()
+	for key, item := range o.recent {
+		if now.Sub(item.at) >= freshness {
+			delete(o.recent, key)
+		}
+	}
+	for key, meta := range w.targets {
+		o.recent[key] = dispatch{meta: meta, at: now}
+	}
+	o.active--
+	o.epoch++
+}
+
+type selection struct {
+	Registered  bool `json:"registered"`
+	Healthy     bool `json:"healthy"`
+	CircuitOpen bool `json:"circuit_open"`
+	InSelection bool `json:"in_selection"`
+}
+
+type worker struct {
+	URL       string    `json:"url"`
+	Port      string    `json:"port"`
+	Role      string    `json:"role"`
+	PodHint   string    `json:"pod_hint"`
+	WorkerID  string    `json:"worker_id"`
+	Selection selection `json:"selection"`
+	LastJob   *struct {
+		Recent bool `json:"recent_dispatch"`
+	} `json:"last_job,omitempty"`
+}
+
+type view struct {
+	Router struct {
+		Boot uint64 `json:"boot_generation"`
+		Now  uint64 `json:"now_ms"`
+	} `json:"router"`
+	Revision uint64   `json:"registry_revision"`
+	Workers  []worker `json:"workers"`
+}
+
+func observedWorker(meta *fwkdl.EndpointMetadata, registered, recent bool) (worker, error) {
+	if meta == nil {
+		return worker{}, errors.New("missing endpoint metadata")
+	}
+	port, err := strconv.Atoi(meta.Port)
+	role := meta.Labels["app.kubernetes.io/component"]
+	if err != nil || port < 1 || port > 65535 || net.ParseIP(meta.Address) == nil || meta.Name == "" || meta.ID.Name == "" || role == "" {
+		return worker{}, errors.New("endpoint identity or listener is incomplete")
+	}
+	result := worker{URL: "http://" + net.JoinHostPort(meta.Address, meta.Port), Port: meta.Port,
+		Role: role, PodHint: meta.Name, WorkerID: meta.ID.String(),
+		Selection: selection{Registered: registered, Healthy: registered, InSelection: registered}}
+	if recent {
+		result.LastJob = &struct {
+			Recent bool `json:"recent_dispatch"`
+		}{true}
+	}
+	return result, nil
+}
+
+func (o *Observer) snapshot() (view, error) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.store == nil || o.supported == nil || !o.supported() {
+		return view{}, errors.New("native routing profile is not covered")
+	}
+	if o.active != 0 {
+		return view{}, errors.New("native endpoint selection or send is pending")
+	}
+	metas, revision, err := o.store.ObserverSnapshot()
+	if err != nil {
+		return view{}, err
+	}
+	now := o.now()
+	rows := make(map[string]worker, len(metas)+len(o.recent))
+	for _, meta := range metas {
+		item, err := observedWorker(meta, true, false)
+		if err != nil {
+			return view{}, err
+		}
+		key := endpointKey(meta)
+		if prior, ok := rows[key]; ok && (prior.Role != item.Role || prior.PodHint != item.PodHint) {
+			return view{}, errors.New("endpoint identity conflicts")
+		}
+		rows[key] = item
+	}
+	for key, item := range o.recent {
+		if now.Before(item.at) || now.Sub(item.at) < freshness {
+			row, err := observedWorker(item.meta, false, true)
+			if err != nil {
+				return view{}, err
+			}
+			if prior, ok := rows[key]; ok {
+				if prior.Role != row.Role || prior.PodHint != row.PodHint {
+					return view{}, errors.New("recent endpoint identity conflicts")
+				}
+				prior.LastJob = row.LastJob
+				row = prior
+			}
+			rows[key] = row
+		}
+	}
+	keys := make([]string, 0, len(rows))
+	for key := range rows {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	result := view{Revision: revision + o.epoch, Workers: make([]worker, 0, len(rows))}
+	result.Router.Boot = o.boot
+	result.Router.Now = uint64(now.UnixMilli())
+	for _, key := range keys {
+		result.Workers = append(result.Workers, rows[key])
+	}
+	return result, nil
+}
+
+func (o *Observer) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", http.MethodGet)
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	result, err := o.snapshot()
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusServiceUnavailable)
+		return
+	}
+	payload, err := json.Marshal(result)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("failed to encode membership: %v", err), http.StatusServiceUnavailable)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = w.Write(payload)
+}
