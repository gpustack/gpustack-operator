+// Copyright 2026 The Kubernetes Authors.
+// SPDX-License-Identifier: Apache-2.0
+package requestcontrol
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"testing"
+
+	fwkdl "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/datalayer"
+	fwksched "github.com/llm-d/llm-d-router/pkg/epp/framework/interface/scheduling"
+	"github.com/llm-d/llm-d-router/pkg/epp/framework/plugins/requesthandling/parsers/openai"
+	"github.com/llm-d/llm-d-router/pkg/epp/handlers"
+	"github.com/llm-d/llm-d-router/pkg/epp/observer"
+	"k8s.io/apimachinery/pkg/types"
+)
+
+type emptyObservedStore struct{}
+
+func (emptyObservedStore) ObserverSnapshot() ([]*fwkdl.EndpointMetadata, uint64, error) {
+	return nil, 1, nil
+}
+func TestObserverRecordsNativeDirectorAuxiliaryTargets(t *testing.T) {
+	makeEndpoint := func(name, address, role string) fwksched.Endpoint {
+		return fwksched.NewEndpoint(&fwkdl.EndpointMetadata{ID: types.NamespacedName{Name: name, Namespace: "ns"}, Name: name, Address: address, Port: "8000", Labels: map[string]string{"app.kubernetes.io/component": role}}, nil, fwkdl.NewAttributes())
+	}
+	result := &fwksched.SchedulingResult{PrimaryProfileName: "decode", ProfileResults: map[string]*fwksched.ProfileRunResult{
+		"decode":  {TargetEndpoints: []fwksched.Endpoint{makeEndpoint("decoder", "192.0.2.1", "decode-role")}},
+		"prefill": {TargetEndpoints: []fwksched.Endpoint{makeEndpoint("prefiller", "192.0.2.2", "prefill-role")}},
+	}}
+	director, ctx := newConditionalDecodeDirector(t, result)
+	o := observer.New(emptyObservedStore{}, func() bool { return true })
+	req := &handlers.RequestContext{ObserverWindow: o.Begin(), Request: &handlers.Request{Headers: map[string]string{":path": "/v1/completions"}, RawBody: []byte(`{"model":"m","prompt":"p"}`)}, Parser: openai.NewOpenAIParser()}
+	defer req.ObserverWindow.Finish()
+	parsed, err := req.Parser.ParseRequest(ctx, req.Request.RawBody, req.Request.Headers)
+	if err != nil {
+		t.Fatal(err)
+	}
+	returned, err := director.HandleRequest(ctx, req, parsed.Body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if returned.TargetPod == nil || returned.TargetPod.Name != "decoder" {
+		t.Fatal("native primary routing was changed")
+	}
+	req.ObserverWindow.Finish()
+	recorder := httptest.NewRecorder()
+	o.ServeHTTP(recorder, httptest.NewRequest("GET", observer.Path, nil))
+	var observed struct {
+		Workers []struct {
+			Pod     string `json:"pod_hint"`
+			LastJob struct {
+				Recent bool `json:"recent_dispatch"`
+			} `json:"last_job"`
+		} `json:"workers"`
+	}
+	if err := json.Unmarshal(recorder.Body.Bytes(), &observed); err != nil {
+		t.Fatal(err)
+	}
+	if recorder.Code != 200 || len(observed.Workers) != 2 {
+		t.Fatalf("native primary/auxiliary target lost: %d %s", recorder.Code, recorder.Body.String())
+	}
+	for _, worker := range observed.Workers {
+		if !worker.LastJob.Recent {
+			t.Fatal("native target has no dispatch evidence")
+		}
+	}
+}
